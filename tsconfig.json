{
    "extends": "./../../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "paths": {
            "*": ["./*"],
            "src/*": ["./src/*"],
            "@repo/fe-ui/*": ["../../../../packages/fe/ui/src/exports/*"],
            "@repo/fe-ui/styles": [
                "../../../../packages/fe/ui/src/styles/index.css"
            ],
            "@repo/fe-ui/styles/*": ["../../../../packages/fe/ui/src/styles/*"],
            "@repo/fe-utils/*": ["../../../../packages/fe/utils/*"],
            "@repo/shared-config": ["../../../../packages/shared/config"],
            "@/lib/shadcn/*": ["../../../../packages/fe/ui/src/lib/shadcn/*"]
        },
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "skipLibCheck": true
    },
    "include": ["./src"]
}
